{
  "name": "bruv",
  "version": "0.16.21",
  "private": true,
  "type": "module",
  "bin": {
    "bruv": "dist/bruv",
    "bruv-claude-compat": "dist/bruv-claude-compat"
  },
  "scripts": {
    "ci": "bash ./scripts/ci/ci.sh linux",
    "ci:macos": "bash ./scripts/ci/ci.sh macos",
    "prepare:assets": "bun ./scripts/build/prepare-assets.ts",
    "build": "bun ./scripts/build/build-pair.ts",
    "check": "bun run prepare:assets && tsc --noEmit",
    "test": "bun run build && bun test ./tests",
    "test:llm": "bun run build && BRUV_RUN_LLM_TESTS=1 bun test ./tests/agent/llm.test.ts",
    "install:local": "./scripts/release/install-local.sh",
    "smoke": "./scripts/ci/smoke.sh",
    "tui": "bun ./scripts/tui/tui-harness.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "generate:notices": "bun ./scripts/dependencies/generate-third-party-notices.ts",
    "prompt:preview": "bun ./scripts/prompt-preview.ts",
    "smoke:live-onboarding": "bun ./scripts/live/onboarding-smoke.ts",
    "build:claude-compat": "bun ./scripts/build/build-claude-compat.ts",
    "perf:terminal": "bun ./scripts/terminal-perf/terminal-perf.ts",
    "perf:interactions": "bun ./scripts/terminal-perf/terminal-interactions.ts",
    "perf:resources": "bun ./scripts/resource-harness/run.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-server": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@google/genai": "2.27.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "es-module-lexer": "^3.0.3",
    "resolve.exports": "2.0.3",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.2",
    "@types/ws": "8.18.2",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.1"
  },
  "license": "MIT",
  "patchedDependencies": {
    "@earendil-works/pi-coding-agent@1.1.0": "patches/@earendil-works%2Fpi-coding-agent@1.1.0.patch",
    "@earendil-works/pi-tui@1.1.0": "patches/@earendil-works%2Fpi-tui@1.1.0.patch"
  }
}
