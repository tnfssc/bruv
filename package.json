{
  "name": "bruv",
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "site",
    "web"
  ],
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions/bruv.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@types/bun": "1.4.2",
    "@types/ws": "^8.18.2",
    "typebox": "1.3.27",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "scripts": {
    "check": "tsc --noEmit && tsc --noEmit -p site && tsc --noEmit -p web",
    "lint": "biome ci .",
    "test": "bun test",
    "test:site": "bun run --cwd site test:unit",
    "build:web": "bun run --cwd web build"
  },
  "dependencies": {
    "sherpa-onnx-node": "1.13.8",
    "smol-toml": "^1.9.1",
    "uqr": "0.1.3",
    "ws": "^8.22.0"
  }
}
