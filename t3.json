{
  "$schema": "https://t3.codes/schema/t3.json",
  "scripts": [
    {
      "name": "Setup Worktree",
      "command": "mise trust -y --quiet; bun install --frozen-lockfile && bun run prepare:assets",
      "icon": "configure",
      "runOnWorktreeCreate": true
    },
    {
      "name": "CI Checks",
      "command": "env SHELL=/bin/sh bun run ci",
      "icon": "test"
    },
    {
      "name": "Build",
      "command": "bun run build",
      "icon": "build"
    },
    {
      "name": "Terminal Frame Lab",
      "command": "bun run perf:terminal",
      "icon": "debug",
      "async": true
    },
    {
      "name": "Terminal Interaction Lab",
      "command": "bun run perf:interactions",
      "icon": "debug",
      "async": true
    }
  ]
}
