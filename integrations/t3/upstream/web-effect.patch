diff --git a/apps/web/src/numberSchemaBoundaries.test.ts b/apps/web/src/numberSchemaBoundaries.test.ts
new file mode 100644
index 0000000..22185eb
--- /dev/null
+++ b/apps/web/src/numberSchemaBoundaries.test.ts
@@ -0,0 +1,46 @@
+import { describe, expect, it } from "vite-plus/test";
+import * as Schema from "effect/Schema";
+import { PersistedComposerFileAttachment } from "./composerDraftStore";
+import { ReviewCommentContextSchema } from "./reviewCommentContext";
+import { PrimaryEnvironmentAuthSessionTimeoutError } from "./environments/primary/auth";
+
+const invalidNumbers = [NaN, Infinity, -Infinity];
+
+const file = {
+  id: "attachment", name: "a.txt", mimeType: "text/plain", sizeBytes: 12,
+  attachmentId: "upload", environmentId: "local",
+};
+const comment = {
+  id: "comment", sectionId: "section", sectionTitle: "Section", filePath: "a.ts",
+  startIndex: 0, endIndex: 1, rangeLabel: "L1-L2", text: "note", diff: "diff",
+  selection: { start: 1, end: 2, side: "additions", endSide: "additions" },
+};
+
+describe("persisted numeric schema boundaries", () => {
+  it("accepts finite attachment sizes and rejects non-finite serialized sizes", () => {
+    expect(Schema.is(PersistedComposerFileAttachment)(file)).toBe(true);
+    for (const value of invalidNumbers) {
+      expect(Schema.is(PersistedComposerFileAttachment)({ ...file, sizeBytes: value })).toBe(false);
+    }
+  });
+
+  it("rejects non-finite review indices and line positions while preserving finite positions", () => {
+    expect(Schema.is(ReviewCommentContextSchema)(comment)).toBe(true);
+    for (const value of invalidNumbers) {
+      for (const key of ["startIndex", "endIndex"] as const) {
+        expect(Schema.is(ReviewCommentContextSchema)({ ...comment, [key]: value })).toBe(false);
+      }
+      for (const key of ["start", "end"] as const) {
+        expect(Schema.is(ReviewCommentContextSchema)({ ...comment, selection: { ...comment.selection, [key]: value } })).toBe(false);
+      }
+    }
+  });
+
+  it("keeps diagnostic payload numbers unmodified, even when invalid", () => {
+    for (const value of invalidNumbers) {
+      expect(Schema.is(PrimaryEnvironmentAuthSessionTimeoutError)(
+        new PrimaryEnvironmentAuthSessionTimeoutError({ timeoutMs: value, elapsedMs: value }),
+      )).toBe(true);
+    }
+  });
+});
