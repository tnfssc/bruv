+// @effect-diagnostics nodeBuiltinImport:off - Git ref resolution is a bounded argv-only subprocess boundary.
+import { execFile } from "node:child_process";
+import { createHash } from "node:crypto";
+import { promisify } from "node:util";
+
+import {
+  CommandId,
+  type DieLocalJobNotifyInput,
+  type DieLocalJobNotifyResult,
+  type DieTaskCancelInput,
+  type DieTaskLaunchInput,
+  type DieTaskListInput,
+  type DieTaskListResult,
