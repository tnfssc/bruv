+      return { projection, policy: scope.dieDelegation };
+    });
+  const ownedTask = (projection: OrchestrationV2ThreadProjection, taskId: NodeId) => {
+    const task = projection.subagents.find(
+      (candidate) =>
+        candidate.id === taskId &&
+        candidate.origin === "app_owned" &&
+        profileFromMarkedPrompt(candidate.prompt) !== undefined,
+    );
+    return task?.childThreadId === null || task === undefined ? undefined : task;
+  };
+  const workspaceResult = (
+    task: OrchestrationV2Subagent,
+    child: OrchestrationV2ThreadProjection,
+    run: ReturnType<typeof delegatedTaskRun>,
+    preparationKnown: boolean,
+  ) => {
+    const workspace = task.delegatedWorkspace;
+    if (workspace === undefined || workspace.kind === "inherit") return undefined;
+    const worktreePath = child.thread.worktreePath ?? undefined;
+    const providerStarted = run?.providerThreadId !== null && run?.providerThreadId !== undefined;
