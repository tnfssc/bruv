+import { describe, expect, it } from "vite-plus/test";
+import type { NativeThreadUsageReport, NativeUsageTotals } from "@t3tools/contracts";
+
+import { nativeCostSummary, shouldShowNativeCostSummary } from "./nativeUsageCost.logic";
+
+const totals = (overrides: Partial<NativeUsageTotals> = {}): NativeUsageTotals => ({
+  turns: 0,
+  completeTurns: 0,
+  partialTurns: 0,
+  unavailableTurns: 0,
+  inputTokens: 0,
+  cachedInputTokens: 0,
+  cacheCreationTokens: 0,
+  outputTokens: 0,
+  reasoningTokens: 0,
+  costUsd: 0,
+  costKnownTurns: 0,
+  costUnavailableTurns: 0,
+  costStatus: "unavailable",
+  ...overrides,
+});
+
+const report = (
+  own: NativeUsageTotals,
+  subtree: NativeUsageTotals = own,
+): NativeThreadUsageReport => ({
+  own,
+  subtree,
+  descendantThreadIds: [],
+});
+
+describe("shouldShowNativeCostSummary", () => {
+  it("hides empty homepage usage before any turn is recorded", () => {
+    expect(shouldShowNativeCostSummary(null)).toBe(false);
+    expect(shouldShowNativeCostSummary(report(totals()))).toBe(false);
+  });
+
+  it("shows a legitimately zero-priced recorded turn", () => {
+    const zeroPriced = totals({
+      turns: 1,
+      completeTurns: 1,
+      costKnownTurns: 1,
+      costStatus: "complete",
+    });
+
+    expect(shouldShowNativeCostSummary(report(zeroPriced))).toBe(true);
+  });
+
+  it("shows unavailable cost when a real recorded turn lacks a price", () => {
+    const unknownCost = totals({
+      turns: 1,
+      unavailableTurns: 1,
+      costUnavailableTurns: 1,
+    });
+
+    expect(shouldShowNativeCostSummary(report(unknownCost))).toBe(true);
+  });
+
+  it("shows activity recorded only in the delegated subtree", () => {
+    const subtreeOnly = totals({
+      turns: 1,
+      completeTurns: 1,
+      costKnownTurns: 1,
+      costStatus: "complete",
+    });
+
+    expect(shouldShowNativeCostSummary(report(totals(), subtreeOnly))).toBe(true);
+  });
+});
+
+describe("nativeCostSummary", () => {
+  it("renders a single priced or unavailable cost when own and subtree are the same", () => {
+    expect(nativeCostSummary(report(totals({ turns: 1, costUsd: 0.004, costStatus: "complete" }))))
+      .toBe("Cost $0.0040");
+    expect(nativeCostSummary(report(totals({ turns: 1, costStatus: "unavailable" }))))
+      .toBe("Cost unavailable");
+    expect(nativeCostSummary(report(totals({ turns: 1, costStatus: "complete" }))))
+      .toBe("Cost $0.0000");
+  });
+
+  it("keeps the thread and total distinction when delegated usage differs", () => {
+    expect(nativeCostSummary(report(
+      totals({ turns: 1, costUsd: 0.02, costStatus: "complete" }),
+      totals({ turns: 2, costUsd: 0.03, costStatus: "partial" }),
+    ))).toBe("Cost $0.03 (partial) total · $0.02 this thread");
+    expect(nativeCostSummary(report(totals(), totals({ turns: 1, costStatus: "unavailable" }))))
+      .toBe("Cost unavailable total · no turns this thread");
+  });
+
+  it("keeps a distinct total even when rounded display amounts coincide", () => {
+    expect(nativeCostSummary(report(
+      totals({ turns: 1, costUsd: 0.02, costStatus: "complete" }),
+      totals({ turns: 2, costUsd: 0.02, costStatus: "complete" }),
+    ))).toBe("Cost $0.02 total · $0.02 this thread");
+  });
+});
diff --git a/apps/web/src/components/chat/nativeUsageCost.logic.ts b/apps/web/src/components/chat/nativeUsageCost.logic.ts
new file mode 100644
index 00000000..e73ddbb0
--- /dev/null
+++ b/apps/web/src/components/chat/nativeUsageCost.logic.ts
@@ -0,0 +1,19 @@
+import type { NativeThreadUsageReport } from "@t3tools/contracts";
+
+/** Only show cost once this thread or its delegated subtree has recorded a provider turn. */
+export function shouldShowNativeCostSummary(usage: NativeThreadUsageReport | null): boolean {
+  return usage !== null && (usage.own.turns > 0 || usage.subtree.turns > 0);
+}
+
+/** Collapse the identical own/subtree pair until delegated usage adds a distinct total. */
+export function nativeCostSummary(usage: NativeThreadUsageReport): string {
+  const format = (totals: NativeThreadUsageReport["own"]): string => {
+    if (totals.costStatus === "unavailable") return "unavailable";
+    const amount = totals.costUsd < 0.01 ? totals.costUsd.toFixed(4) : totals.costUsd.toFixed(2);
+    return `$${amount}${totals.costStatus === "partial" ? " (partial)" : ""}`;
+  };
+  const own = format(usage.own);
+  const subtree = format(usage.subtree);
+  if (usage.own.turns === usage.subtree.turns && own === subtree) return `Cost ${subtree}`;
+  return `Cost ${subtree} total · ${usage.own.turns === 0 ? "no turns" : own} this thread`;
+}
