new file mode 100644
index 00000000..0e43a925
--- /dev/null
+++ b/apps/web/src/numberSchemaBoundaries.test.ts
@@ -0,0 +1,58 @@
+import { describe, expect, it } from "vite-plus/test";
+import * as Schema from "effect/Schema";
+import { PersistedComposerFileAttachment } from "./composerDraftStore";
+import { ReviewCommentContextSchema } from "./reviewCommentContext";
+import { PrimaryEnvironmentAuthSessionTimeoutError, PrimaryEnvironmentPairingCredentialRejectedError, PrimaryEnvironmentPairingCredentialRequiredError, PrimaryEnvironmentRequestError } from "./environments/primary/auth";
+import { BrowserRecordingCaptureTimeoutError } from "./browser/browserRecording";
+import { DesktopUpdateStateReadError } from "./state/desktopUpdate";
+
+const invalidNumbers = [NaN, Infinity, -Infinity];
+
+const file = {
+  id: "attachment", name: "a.txt", mimeType: "text/plain", sizeBytes: 12,
+  attachmentId: "upload", environmentId: "local",
+};
+const comment = {
+  id: "comment", sectionId: "section", sectionTitle: "Section", filePath: "a.ts",
+  startIndex: 0, endIndex: 1, rangeLabel: "L1-L2", text: "note", diff: "diff",
+  selection: { start: 1, end: 2, side: "additions", endSide: "additions" },
+};
+
+describe("persisted numeric schema boundaries", () => {
+  it("accepts finite attachment sizes and rejects non-finite serialized sizes", () => {
+    expect(Schema.is(PersistedComposerFileAttachment)(file)).toBe(true);
+    for (const value of invalidNumbers) {
+      expect(Schema.is(PersistedComposerFileAttachment)({ ...file, sizeBytes: value })).toBe(false);
+    }
+  });
+
+  it("rejects non-finite review indices and line positions while preserving finite positions", () => {
+    expect(Schema.is(ReviewCommentContextSchema)(comment)).toBe(true);
+    for (const value of invalidNumbers) {
+      for (const key of ["startIndex", "endIndex"] as const) {
+        expect(Schema.is(ReviewCommentContextSchema)({ ...comment, [key]: value })).toBe(false);
+      }
+      for (const key of ["start", "end"] as const) {
+        expect(Schema.is(ReviewCommentContextSchema)({ ...comment, selection: { ...comment.selection, [key]: value } })).toBe(false);
+      }
+    }
+  });
+
+  it("validates measured diagnostic fields from constants, string lengths, clocks and HTTP status", () => {
+    const cause = new Error("fixture");
+    const cases = [
+      { is: Schema.is(BrowserRecordingCaptureTimeoutError), value: new BrowserRecordingCaptureTimeoutError({ tabId: "tab", timeoutMs: 1000 }), fields: ["timeoutMs"] },
+      { is: Schema.is(PrimaryEnvironmentAuthSessionTimeoutError), value: new PrimaryEnvironmentAuthSessionTimeoutError({ timeoutMs: 1000, elapsedMs: 1001 }), fields: ["timeoutMs", "elapsedMs"] },
+      { is: Schema.is(PrimaryEnvironmentPairingCredentialRejectedError), value: new PrimaryEnvironmentPairingCredentialRejectedError({ providedLength: 5, cause }), fields: ["providedLength"] },
+      { is: Schema.is(PrimaryEnvironmentPairingCredentialRequiredError), value: new PrimaryEnvironmentPairingCredentialRequiredError({ providedLength: 0 }), fields: ["providedLength"] },
+      { is: Schema.is(PrimaryEnvironmentRequestError), value: new PrimaryEnvironmentRequestError({ operation: "fetch-session-state", status: 500, cause }), fields: ["status"] },
+      { is: Schema.is(DesktopUpdateStateReadError), value: new DesktopUpdateStateReadError({ attemptCount: 3, cause }), fields: ["attemptCount"] },
+    ];
+    for (const entry of cases) {
+      expect(entry.is(entry.value)).toBe(true);
+      for (const field of entry.fields) for (const value of invalidNumbers) {
+        expect(entry.is({ ...entry.value, [field]: value })).toBe(false);
+      }
+    }
+  });
+});
