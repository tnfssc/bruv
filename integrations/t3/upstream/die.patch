diff --git a/apps/server/src/provider/DieWebPi.test.ts b/apps/server/src/provider/DieWebPi.test.ts
new file mode 100644
index 00000000..9d2bb056
--- /dev/null
+++ b/apps/server/src/provider/DieWebPi.test.ts
@@ -0,0 +1,42 @@
+import { assert, describe, it } from "@effect/vitest";
+import * as Schema from "effect/Schema";
+import { PiSettings } from "@t3tools/contracts";
+
+import { applyDieWebPiSettings, dieWebBinary, isTrustedDieProviderInstance } from "./DieWebPi.ts";
+
+const decode = Schema.decodeSync(PiSettings);
+
+describe("Die web Pi settings", () => {
+  it("uses the scoped Die executable and enables the RPC provider", () => {
+    const settings = applyDieWebPiSettings(
+      { ...decode({}), enabled: false, binaryPath: "pi" },
+      { DIE_WEB_DIE_BINARY: " /opt/die " },
+    );
+    assert.equal(settings.binaryPath, "/opt/die");
+    assert.isTrue(settings.enabled);
+  });
+
+  it("does not alter an ordinary Pi configuration", () => {
+    const settings = { ...decode({}), binaryPath: "/opt/pi" };
+    assert.strictEqual(applyDieWebPiSettings(settings, {}), settings);
+    assert.isUndefined(dieWebBinary({ DIE_WEB_DIE_BINARY: "  " }));
+  });
+});
+
+it("trusts only the built-in pi identity when server configuration replaces Pi with Die", () => {
+  const environment = { DIE_WEB_DIE_BINARY: "/opt/die" };
+  assert.isTrue(isTrustedDieProviderInstance("pi", environment));
+  assert.isFalse(isTrustedDieProviderInstance("pi-secondary", environment));
+  assert.isFalse(isTrustedDieProviderInstance("pi", {}));
+
+  // The server setting replaces, rather than supplements, the executable for
+  // the pi runtime; an ordinary Pi process cannot occupy this identity in the
+  // same configured server.
+  assert.equal(
+    applyDieWebPiSettings(
+      { enabled: true, binaryPath: "/opt/ordinary-pi", args: [] } as any,
+      environment,
+    ).binaryPath,
+    "/opt/die",
+  );
+});
diff --git a/apps/server/src/provider/DieWebPi.ts b/apps/server/src/provider/DieWebPi.ts
new file mode 100644
index 00000000..c09c1fec
--- /dev/null
+++ b/apps/server/src/provider/DieWebPi.ts
@@ -0,0 +1,29 @@
+import type { PiSettings } from "@t3tools/contracts";
+
+export const DIE_WEB_BINARY_ENV = "DIE_WEB_DIE_BINARY";
+
+export function dieWebBinary(environment: NodeJS.ProcessEnv): string | undefined {
+  const value = environment[DIE_WEB_BINARY_ENV]?.trim();
+  return value ? value : undefined;
+}
+
+/** Die web reuses the Pi RPC protocol, but owns its executable and tool surface. */
+export function applyDieWebPiSettings(
+  settings: PiSettings,
+  environment: NodeJS.ProcessEnv,
+): PiSettings {
+  const binaryPath = dieWebBinary(environment);
+  return binaryPath === undefined ? settings : { ...settings, enabled: true, binaryPath };
+}
+
+/**
+ * Native delegation authority is reserved for the built-in Pi instance when
+ * the server operator has replaced that runtime with Die. Provider/model
+ * environment is deliberately not an identity signal.
+ */
+export function isTrustedDieProviderInstance(
+  providerInstanceId: string,
+  environment: NodeJS.ProcessEnv,
+): boolean {
+  return providerInstanceId === "pi" && dieWebBinary(environment) !== undefined;
+}
