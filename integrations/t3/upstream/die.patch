+
+const MAX_OBSERVED_OUTPUT_CHARS = 64_000;
+const DEFAULT_LIST_COUNT = 20;
+const execFileAsync = promisify(execFile);
+const COMMIT_OID = /^(?:[0-9a-f]{40}|[0-9a-f]{64})$/;
+
+/** Resolve one Git commit through argv only; never pass user refs through a shell. */
+export async function resolveGitCommitOid(cwd: string, ref: string): Promise<string> {
+  if (ref.includes("\0") || ref.trim().length === 0) throw new Error("Git baseRef is invalid.");
+  const { stdout } = await execFileAsync(
+    "git",
+    ["-C", cwd, "rev-parse", "--verify", "--end-of-options", `${ref}^{commit}`],
+    { encoding: "utf8", maxBuffer: 1024 * 1024 },
+  );
+  const oid = stdout.trim();
+  if (!COMMIT_OID.test(oid)) throw new Error("Git did not return an immutable commit OID.");
+  return oid;
+}
+
+const rolePrompt: Record<DieTaskProfile, string> = {
+  fast: "Act as a focused fast worker. Solve the bounded task directly and report a concise result.",
+  normal:
+    "Act as an implementation worker. Complete the task, verify the result, and report concrete evidence.",
+  orchestrator:
+    "Act as an orchestrator. Decompose when useful, coordinate delegated work, verify integration, and report one coherent result.",
+};
+const encodedPrompt = (profile: DieTaskProfile, prompt: string) =>
+  `${DIE_PROMPT_MARKER} profile=${profile}\n${rolePrompt[profile]}\n\n${prompt}`;
+const fail = (code: OrchestratorMcpFailure["code"], message: string) =>
+  new OrchestratorMcpFailure({ code, message });
+function statusForRun(run: OrchestrationV2Run | undefined): DieTaskResult["status"] {
+  switch (run?.status) {
+    case "completed":
+      return "completed";
+    case "failed":
+      return "failed";
+    case "cancelled":
+    case "rolled_back":
+    case "interrupted":
+      return "cancelled";
+    default:
+      return "running";
+  }
+}
+
+export interface DieTaskServiceShape {
+  readonly notifyLocalJob: (
+    scope: McpInvocationScope,
+    input: DieLocalJobNotifyInput,
+  ) => Effect.Effect<DieLocalJobNotifyResult, OrchestratorMcpFailure>;
+  readonly launch: (
+    scope: McpInvocationScope,
+    input: DieTaskLaunchInput,
+  ) => Effect.Effect<DieTaskResult, OrchestratorMcpFailure>;
+  readonly observe: (
+    scope: McpInvocationScope,
+    taskId: NodeId,
+  ) => Effect.Effect<DieTaskResult, OrchestratorMcpFailure>;
+  readonly cancel: (
+    scope: McpInvocationScope,
+    input: DieTaskCancelInput,
+  ) => Effect.Effect<DieTaskResult, OrchestratorMcpFailure>;
+  readonly list: (
+    scope: McpInvocationScope,
+    input: DieTaskListInput,
+  ) => Effect.Effect<DieTaskListResult, OrchestratorMcpFailure>;
+}
+export class DieTaskService extends Context.Service<DieTaskService, DieTaskServiceShape>()(
+  "t3/mcp/DieTaskService",
+) {}
+
+const make = Effect.gen(function* () {
+  const threadManagement = yield* ThreadManagementService;
+  const orchestrator = yield* OrchestratorMcpService;
+  const threadLaunch = yield* ThreadLaunch.ThreadLaunchService;
+  const projects = yield* Effect.serviceOption(ProjectService.ProjectService);
+  const load = (threadId: ThreadId) =>
+    threadManagement
+      .getThreadProjection(threadId)
+      .pipe(
+        Effect.mapError((error) =>
+          fail("orchestration_error", `Unable to read delegation state: ${String(error)}`),
+        ),
+      );
