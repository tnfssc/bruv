+++ b/apps/server/src/orchestration-v2/NativeUsageAccounting.test.ts
@@ -0,0 +1,169 @@
+import { assert, it } from "@effect/vitest";
+import {
+  ProviderTurnId,
+  ThreadId,
+  type OrchestrationV2AppThread,
+  type OrchestrationV2ProviderTurn,
+  type TurnTokenUsage,
+} from "@t3tools/contracts";
+
+import { nativeThreadUsageReport, type NativeUsageProjection } from "./NativeUsageAccounting.ts";
+import { delegatedTaskProgress } from "./SubagentProjection.ts";
+
+const rootId = ThreadId.make("die-root");
+const childId = ThreadId.make("die-child");
+const nestedId = ThreadId.make("die-nested");
+
+function projection(
+  id: ThreadId,
+  parentThreadId: ThreadId | null,
+  relationshipToParent: "subagent" | "fork" | null,
+  turns: ReadonlyArray<[string, TurnTokenUsage | undefined]>,
+): NativeUsageProjection {
+  return {
+    thread: {
+      id,
+      lineage: { parentThreadId, relationshipToParent, rootThreadId: rootId },
+    } as Pick<OrchestrationV2AppThread, "id" | "lineage">,
+    providerTurns: turns.map(([turnId, turnTokenUsage]) => ({
+      id: ProviderTurnId.make(turnId),
+      turnTokenUsage,
+    })) as ReadonlyArray<Pick<OrchestrationV2ProviderTurn, "id" | "turnTokenUsage">>,
+  };
+}
+
+const complete = (
+  inputTokens: number,
+  outputTokens: number,
+  hasSubagents = false,
+  totalCostUsd?: number,
+): TurnTokenUsage => ({
+  usageScope: "main_agent",
+  usageStatus: "complete",
+  hasSubagents,
+  inputTokens,
+  cachedInputTokens: Math.floor(inputTokens / 2),
+  outputTokens,
+  ...(totalCostUsd === undefined ? {} : { totalCostUsd }),
+});
+
+it("counts every native descendant's own turns once without multiplying parent aggregates", () => {
+  const root = projection(rootId, null, null, [["root-turn", complete(100, 10, true, 1.25)]]);
+  const child = projection(childId, rootId, "subagent", [
+    ["child-attempt-1", complete(20, 2, true, 0.2)],
+    ["child-attempt-2", complete(30, 3, true, 0.3)], // retry/compaction is real additional use
+  ]);
+  const nested = projection(nestedId, childId, "subagent", [
+    ["nested-turn", complete(7, 1, false, 0.07)],
+  ]);
+  const fork = projection(ThreadId.make("fork"), rootId, "fork", [
+    ["fork-turn", complete(999, 999, false, 99)],
+  ]);
+
+  // Reconnect/replay can hand accounting the same turn again. The stronger
+  // final record wins and its stable provider-turn identity is still one unit.
+  const childReplay = projection(childId, rootId, "subagent", [
+    [
+      "child-attempt-2",
+      {
+        usageScope: "main_agent",
+        usageStatus: "partial",
+        hasSubagents: true,
+        inputTokens: 30,
+        totalCostUsd: 0.3,
+      },
+    ],
+  ]);
+
+  const report = nativeThreadUsageReport(rootId, [root, child, nested, fork, childReplay]);
+  assert.deepStrictEqual(report.descendantThreadIds, [childId, nestedId]);
+  assert.equal(report.own.turns, 1);
+  assert.equal(report.own.inputTokens, 100);
+  assert.equal(report.subtree.turns, 4);
+  assert.equal(report.subtree.completeTurns, 4);
+  assert.equal(report.subtree.inputTokens, 157);
+  assert.equal(report.subtree.outputTokens, 16);
+  assert.equal(report.own.costUsd, 1.25);
+  assert.equal(report.subtree.costUsd, 1.82);
+  assert.equal(report.subtree.costKnownTurns, 4);
+  assert.equal(report.subtree.costStatus, "complete");
+});
+
+it("preserves partial usage from failed/cancelled turns and exposes missing usage", () => {
+  const report = nativeThreadUsageReport(rootId, [
+    projection(rootId, null, null, [["root", complete(5, 1, true)]]),
+    projection(childId, rootId, "subagent", [
+      [
+        "failed",
+        {
+          usageScope: "main_agent",
+          usageStatus: "partial",
+          hasSubagents: false,
+          outputTokens: 4,
+          reasoningTokens: 2,
+          totalCostUsd: 0.04,
+        },
+      ],
+      ["cancelled-before-report", undefined],
+    ]),
+  ]);
+  assert.equal(report.subtree.turns, 3);
+  assert.equal(report.subtree.completeTurns, 1);
+  assert.equal(report.subtree.partialTurns, 1);
+  assert.equal(report.subtree.unavailableTurns, 1);
+  assert.equal(report.subtree.outputTokens, 5);
+  assert.equal(report.subtree.reasoningTokens, 2);
+  assert.equal(report.subtree.costUsd, 0.04);
+  assert.equal(report.subtree.costKnownTurns, 1);
+  assert.equal(report.subtree.costUnavailableTurns, 2);
+  assert.equal(report.subtree.costStatus, "partial");
+});
+
+it("keeps parent liveness working through child transfer and emits one idle edge after reconnect", () => {
+  const run = {
+    id: "parent-run",
+    status: "completed",
+    ordinal: 1,
+    startedAt: {} as never,
+  };
+  const base = { runs: [run], messages: [], providerThreads: [] };
+  const snapshots = [
+    { ...base, subagents: [{ status: "running" }] },
+    // Child finished, but native transfer has not yet been delivered.
+    {
+      ...base,
+      subagents: [
+        { status: "completed", completionDelivery: { state: "pending", observedByRunId: null } },
+      ],
+    },
+    {
+      ...base,
+      subagents: [
+        {
+          status: "completed",
+          completionDelivery: { state: "acknowledged", observedByRunId: null },
+        },
+      ],
+    },
+    // Reconnected projection repeats the settled state.
+    {
+      ...base,
+      subagents: [
+        {
+          status: "completed",
+          completionDelivery: { state: "acknowledged", observedByRunId: null },
+        },
+      ],
+    },
+  ] as const;
+
+  const states = snapshots.map((snapshot) => delegatedTaskProgress(snapshot as never).state);
+  assert.deepStrictEqual(states, [
+    "waiting_for_children",
+    "waiting_for_children",
+    "result_available",
+    "result_available",
+  ]);
+  const edges = states.filter((state, index) => index === 0 || state !== states[index - 1]);
+  assert.deepStrictEqual(edges, ["waiting_for_children", "result_available"]);
+});
