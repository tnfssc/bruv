diff --git a/apps/web/vite/libheifBrowser.ts b/apps/web/vite/libheifBrowser.ts
new file mode 100644
index 00000000..00000000
--- /dev/null
+++ b/apps/web/vite/libheifBrowser.ts
@@ -0,0 +1,28 @@
+import type { Plugin } from "vite-plus";
+
+// libheif-js 1.23.2 ships one Emscripten glue file for both Node and browsers.
+// The browser worker passes wasmBinary explicitly; its Node filesystem and
+// crypto branches cannot run there, but their static require() calls trigger
+// Rolldown browser-external warnings. Remove only those branches before
+// module resolution. Fail on upstream changes rather than silently shipping
+// different glue or replacing Node APIs with fake browser shims.
+export function libheifBrowser(): Plugin {
+  return {
+    name: "t3code:libheif-browser-worker",
+    enforce: "pre",
+    transform(code, id) {
+      if (!/[/\\]libheif-js[/\\]libheif-wasm[/\\]libheif\.js$/.test(id)) return;
+      const nodeLoader = /if\(ge\)\{.*?\}else(?=\(Yr\|\|me\)\&\&)/s;
+      const nodeRandom = /if\(ge\)try\{.*?\}catch\{\}/s;
+      const nodeStdin = /if\(ge\)\{var r=256,_=Buffer\.alloc\(r\).*?\}else (?=typeof window)/s;
+      if (!nodeLoader.test(code) || !nodeRandom.test(code) || !nodeStdin.test(code)) {
+        throw new Error("Unexpected libheif-js glue layout: review browser-only worker transform");
+      }
+      const browserCode = code.replace(nodeLoader, "").replace(nodeRandom, "").replace(nodeStdin, "");
+      if (/require\(["'](?:fs|path|crypto)["']\)/.test(browserCode)) {
+        throw new Error("Node imports remain in libheif browser worker");
+      }
+      return { code: browserCode, map: null };
+    },
+  };
+}
diff --git a/apps/web/vite/shikiAssets.ts b/apps/web/vite/shikiAssets.ts
new file mode 100644
index 00000000..acba3a04
--- /dev/null
+++ b/apps/web/vite/shikiAssets.ts
@@ -0,0 +1,37 @@
+import { createRequire } from "node:module";
+import { pathToFileURL } from "node:url";
+// @effect-diagnostics-next-line nodeBuiltinImport:off - Vite reads build inputs before an Effect runtime exists.
+import { readFileSync } from "node:fs";
+import type { Plugin } from "vite-plus";
+
+// Pierre's worker imports shiki/wasm (a base64 JS module). Load the same pinned
+// Oniguruma binary as a native asset, on demand when the WASM engine is selected.
+const workerUrl = new URL(import.meta.resolve("@pierre/diffs/worker/worker.js"));
+const shikiWasmModule = createRequire(workerUrl).resolve("shiki/wasm");
+const onigWasm = new URL("./onig.wasm", pathToFileURL(shikiWasmModule));
+
+export function shikiDataAssets(): Plugin {
+  return {
+    name: "t3code:shiki-data-assets",
+    apply: "build",
+    transform(code, id) {
+      // The bundled Shiki loader imports this module through shiki/wasm.
+      // Replace the base64 JS module at its source, in both the browser and
+      // the separate worker compilation (whose Vite plugin pipeline differs).
+      if (/[\/]@shikijs[\/]engine-oniguruma[\/]dist[\/]wasm-inlined\.mjs$/.test(id)) {
+        const asset = this.emitFile({ type: "asset", name: "onig.wasm", source: readFileSync(onigWasm) });
+        return { code: `export default async function instantiate(info) { const response = await fetch(import.meta.ROLLUP_FILE_URL_${asset}); const result = WebAssembly.instantiateStreaming ? await WebAssembly.instantiateStreaming(response, info) : await WebAssembly.instantiate(await response.arrayBuffer(), info); return result.instance.exports; }`, map: null };
+      }
+      // Shiki grammars are JSON data wrapped in JS; preserve the module's
+      // imports/exports and lazy boundaries, but ship the large payloads as
+      // JSON assets instead of parsing hundreds of KB of JS source.
+      if (!/[\/]@shikijs[\/]langs[\/]dist[\/](?:emacs-lisp|cpp)\.mjs$/.test(id)) return;
+      const match = /Object\.freeze\(JSON\.parse\(("(?:\\.|[^"\\])*")\)\)/.exec(code);
+      if (!match) throw new Error(`Unexpected Shiki grammar format: ${id}`);
+      const json = JSON.parse(match[1]!);
+      JSON.parse(json); // fail the build if Shiki's expected data shape changes
+      const asset = this.emitFile({ type: "asset", name: id.endsWith("cpp.mjs") ? "cpp.json" : "emacs-lisp.json", source: json });
+      return { code: code.replace(match[0], `Object.freeze(await (await fetch(import.meta.ROLLUP_FILE_URL_${asset})).json())`), map: null };
+    },
+  };
+}
