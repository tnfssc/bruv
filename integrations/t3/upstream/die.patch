+export const SYNTAX_HIGHLIGHTER_CACHE_LIMIT = 64;
+
 const highlighterPromiseCache = new Map<string, Promise<DiffsHighlighter>>();
+const unsupportedLanguageLabels = new Set<string>();
+
+function rememberUnsupportedLanguage(language: string): void {
+  unsupportedLanguageLabels.delete(language);
+  unsupportedLanguageLabels.add(language);
+  while (unsupportedLanguageLabels.size > SYNTAX_HIGHLIGHTER_CACHE_LIMIT) {
+    const oldestLanguage = unsupportedLanguageLabels.values().next().value;
+    if (oldestLanguage === undefined) break;
+    unsupportedLanguageLabels.delete(oldestLanguage);
+  }
+}
+
+function cacheHighlighterPromise(language: string, promise: Promise<DiffsHighlighter>): void {
+  // Refresh existing entries so frequently used supported languages remain cached.
+  highlighterPromiseCache.delete(language);
+  highlighterPromiseCache.set(language, promise);
+
+  while (highlighterPromiseCache.size > SYNTAX_HIGHLIGHTER_CACHE_LIMIT) {
+    const oldestLanguage = highlighterPromiseCache.keys().next().value;
+    if (oldestLanguage === undefined) break;
+    highlighterPromiseCache.delete(oldestLanguage);
