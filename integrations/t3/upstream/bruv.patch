+/** Resolve one Git commit through argv only; never pass user refs through a shell. */
+export async function resolveGitCommitOid(cwd: string, ref: string): Promise<string> {
+  if (ref.includes("\0") || ref.trim().length === 0) throw new Error("Git baseRef is invalid.");
+  const { stdout } = await execFileAsync(
+    "git",
+    ["-C", cwd, "rev-parse", "--verify", "--end-of-options", `${ref}^{commit}`],
+    { encoding: "utf8", maxBuffer: 1024 * 1024 },
+  );
+  const oid = stdout.trim();
+  if (!COMMIT_OID.test(oid)) throw new Error("Git did not return an immutable commit OID.");
+  return oid;
