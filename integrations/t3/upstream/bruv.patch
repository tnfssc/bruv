+      yield* spawner.exitCode(ChildProcess.make("bun", ["--version"]));
+      const stdout = yield* spawner.string(
+        ChildProcess.make("bun", ["--eval", childProgram], {
+          cwd: path.resolve(import.meta.dirname, "../../../.."),
+          env: { ...process.env, TEST_HOME: home, TEST_MODE: mode },
+        }),
+      );
+      const line = stdout.trim().split("\n").at(-1);
+      assert.isDefined(line);
+      return yield* Schema.decodeEffect(
+        Schema.fromJsonString(
+          Schema.Struct({
+            pid: Schema.Int,
+            output: Schema.String,
+            event: Schema.Struct({ exitCode: Schema.Int, signal: Schema.NullOr(Schema.Int) }),
+          }),
+        ),
+      )(line!);
+    }),
+  );
+
+const nativeLayer = NodeServices.layer;
+
+it.effect("uses Bun's native terminal for delayed interactive output, resize, and clean exit", () =>
+  runNativeCase("interactive").pipe(
+    Effect.tap((result) =>
+      Effect.sync(() => {
+        assert.isAbove(result.pid, 0);
+        assert.equal(result.event.exitCode, 0);
+        assert.equal(result.event.signal, null);
+        assert.include(result.output, "__BUN_PTY_READY__");
+        assert.match(result.output, /37\s+101/);
+      }),
+    ),
+    Effect.provide(nativeLayer),
+  ),
+);
+
+it.effect("kills its own native terminal subprocess handle", () =>
+  runNativeCase("kill").pipe(
+    Effect.tap((result) =>
+      Effect.sync(() => {
+        assert.isAbove(result.pid, 0);
+        assert.isTrue(result.event.signal === 9 || result.event.exitCode !== 0);
+      }),
+    ),
+    Effect.provide(nativeLayer),
+  ),
+);
