new file mode 100644
index 0000000000000000000000000000000000000000..179a0827758a67c96cdf32d7c9528736b4ed9ee6
--- /dev/null
+++ b/apps/server/src/provider/BruvWebPi.test.ts
@@ -0,0 +1,46 @@
+import { assert, describe, it } from "@effect/vitest";
+import * as Schema from "effect/Schema";
+import { PiSettings } from "@t3tools/contracts";
+
+import {
+  applyBruvWebPiSettings,
+  bruvWebBinary,
+  isTrustedBruvProviderInstance,
+} from "./BruvWebPi.ts";
+
+const decode = Schema.decodeSync(PiSettings);
+
+describe("Bruv web Pi settings", () => {
+  it("uses the scoped Bruv executable and enables the RPC provider", () => {
+    const settings = applyBruvWebPiSettings(
+      { ...decode({}), enabled: false, binaryPath: "pi" },
+      { BRUV_WEB_BRUV_BINARY: " /opt/bruv " },
+    );
+    assert.equal(settings.binaryPath, "/opt/bruv");
+    assert.isTrue(settings.enabled);
+  });
+
+  it("does not alter an ordinary Pi configuration", () => {
+    const settings = { ...decode({}), binaryPath: "/opt/pi" };
+    assert.strictEqual(applyBruvWebPiSettings(settings, {}), settings);
+    assert.isUndefined(bruvWebBinary({ BRUV_WEB_BRUV_BINARY: "  " }));
+  });
+});
+
+it("trusts only the built-in pi identity when server configuration replaces Pi with Bruv", () => {
+  const environment = { BRUV_WEB_BRUV_BINARY: "/opt/bruv" };
+  assert.isTrue(isTrustedBruvProviderInstance("pi", environment));
+  assert.isFalse(isTrustedBruvProviderInstance("pi-secondary", environment));
+  assert.isFalse(isTrustedBruvProviderInstance("pi", {}));
+
+  // The server setting replaces, rather than supplements, the executable for
+  // the pi runtime; an ordinary Pi process cannot occupy this identity in the
+  // same configured server.
+  assert.equal(
+    applyBruvWebPiSettings(
+      { enabled: true, binaryPath: "/opt/ordinary-pi", args: [] } as any,
+      environment,
+    ).binaryPath,
+    "/opt/bruv",
+  );
+});
diff --git a/apps/server/src/provider/BruvWebPi.ts b/apps/server/src/provider/BruvWebPi.ts
new file mode 100644
index 0000000000000000000000000000000000000000..feaacc80c62c8b3de0cadcfe6bf2f8d391618c2d
--- /dev/null
+++ b/apps/server/src/provider/BruvWebPi.ts
@@ -0,0 +1,29 @@
+import type { PiSettings } from "@t3tools/contracts";
+
+export const BRUV_WEB_BINARY_ENV = "BRUV_WEB_BRUV_BINARY";
+
+export function bruvWebBinary(environment: NodeJS.ProcessEnv): string | undefined {
+  const value = environment[BRUV_WEB_BINARY_ENV]?.trim();
+  return value ? value : undefined;
+}
+
+/** Bruv web reuses the Pi RPC protocol, but owns its executable and tool surface. */
+export function applyBruvWebPiSettings(
+  settings: PiSettings,
+  environment: NodeJS.ProcessEnv,
+): PiSettings {
+  const binaryPath = bruvWebBinary(environment);
+  return binaryPath === undefined ? settings : { ...settings, enabled: true, binaryPath };
+}
+
+/**
+ * Native delegation authority is reserved for the built-in Pi instance when
+ * the server operator has replaced that runtime with Bruv. Provider/model
+ * environment is deliberately not an identity signal.
+ */
+export function isTrustedBruvProviderInstance(
+  providerInstanceId: string,
+  environment: NodeJS.ProcessEnv,
+): boolean {
+  return providerInstanceId === "pi" && bruvWebBinary(environment) !== undefined;
+}
