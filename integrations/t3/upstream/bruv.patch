@@ -0,0 +1,716 @@
+// @effect-diagnostics anyEffect:off nodeBuiltinImport:off - Git-backed tests use isolated /var/tmp repositories.
+import { execFile } from "node:child_process";
+import { mkdtemp, rm, writeFile } from "node:fs/promises";
+import { promisify } from "node:util";
+import { expect, it } from "@effect/vitest";
+import * as Context from "effect/Context";
+import * as Deferred from "effect/Deferred";
+import * as Fiber from "effect/Fiber";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+
+import { ThreadLaunchService } from "../orchestration-v2/ThreadLaunchService.ts";
+import { ThreadManagementService } from "../orchestration-v2/ThreadManagementService.ts";
+import { BruvTaskService, layer, resolveGitCommitOid } from "./BruvTaskService.ts";
+import { OrchestratorMcpService } from "./OrchestratorMcpService.ts";
+
+const execFileAsync = promisify(execFile);
+const git = async (cwd: string, args: readonly string[]) =>
+  (await execFileAsync("git", ["-C", cwd, ...args], { encoding: "utf8" })).stdout.trim();
+const makeGitRepository = async () => {
+  const cwd = await mkdtemp("/var/tmp/bruv-native-workspace-");
+  await git(cwd, ["init", "-q"]);
+  await git(cwd, ["config", "user.name", "Bruv Test"]);
+  await git(cwd, ["config", "user.email", "bruv@example.invalid"]);
+  await writeFile(`${cwd}/tracked.txt`, "first\n");
+  await git(cwd, ["add", "tracked.txt"]);
+  await git(cwd, ["commit", "-qm", "first"]);
+  return cwd;
+};
+const gitRepository = Effect.acquireRelease(Effect.promise(makeGitRepository), (cwd) =>
+  Effect.promise(() => rm(cwd, { recursive: true, force: true })),
+);
+
+const threadLaunchLayer = Layer.succeed(ThreadLaunchService, {
+  launch: () => Effect.die("unexpected thread launch"),
+  isPreparing: () => Effect.succeed(false),
+  prepare: () => Effect.void,
+});
+
+const now = "2026-01-01T00:00:00.000Z";
+const scope = {
+  environmentId: "env",
+  threadId: "thread-parent",
+  providerSessionId: "session-parent",
+  providerInstanceId: "pi",
+  capabilities: new Set(["bruv-delegation"]),
+  bruvDelegation: { profile: "orchestrator", depth: 0 },
+  issuedAt: 1,
+} as any;
+const thread = (id: string, parent: string | null, profile: "fast" | "normal" | "orchestrator") =>
+  ({
+    thread: {
+      id,
+      lineage: {
+        parentThreadId: parent,
+        relationshipToParent: parent === null ? null : "subagent",
+        rootThreadId: "thread-parent",
+      },
+      modelSelection: {
+        instanceId: "pi",
+        model: "default",
+        options: [{ id: "instructionMode", value: profile }],
+      },
+    },
+    runs: [],
+    messages: [],
+    turnItems: [],
+    providerThreads: [],
+    subagents: [],
+    contextTransfers: [],
+  }) as any;
+
+it.effect(
+  "launches asynchronously, reads without ACK, deduplicates, and cancels only the subtree",
+  () =>
+    Effect.gen(function* () {
+      const parent = thread("thread-parent", null, "orchestrator");
+      const child = thread("thread-child", "thread-parent", "normal");
+      child.runs.push({
+        id: "run-child",
+        threadId: "thread-child",
+        status: "running",
+        ordinal: 1,
+        startedAt: now,
+        modelSelection: child.thread.modelSelection,
+      });
+      const grandchild = thread("thread-grandchild", "thread-child", "fast");
+      grandchild.runs.push({
+        id: "run-grandchild",
+        threadId: "thread-grandchild",
+        status: "running",
+        ordinal: 1,
+        startedAt: now,
+        modelSelection: grandchild.thread.modelSelection,
+      });
+      const projections = new Map([
+        ["thread-parent", parent],
+        ["thread-child", child],
+        ["thread-grandchild", grandchild],
+      ]);
+      const delegated: any[] = [];
+      const cancelled: any[] = [];
+      const cancellationRequests = new Set<string>();
+      const orchestrator = {
+        delegateTask: (_scope: any, input: any) =>
+          Effect.sync(() => {
+            delegated.push(input);
+            if (parent.subagents.length === 0)
+              parent.subagents.push({
+                id: "node-child",
+                threadId: "thread-parent",
+                childThreadId: "thread-child",
+                origin: "app_owned",
+                prompt: input.task,
+                delegatedWorkspace: input.delegatedWorkspace,
+                status: "running",
+                result: null,
+                providerInstanceId: "pi",
+                model: "default",
+                updatedAt: now,
+              });
+            return {
+              taskId: "node-child",
+              childThreadId: "thread-child",
+              childRunId: "run-child",
+              childNodeId: "node-child",
+            };
+          }),
+        cancelTask: (callScope: any, input: any) =>
+          Effect.sync(() => {
+            if (!cancellationRequests.has(input.clientRequestId)) {
+              cancellationRequests.add(input.clientRequestId);
+              cancelled.push([callScope.threadId, input.taskId]);
+            }
+            const projection = projections.get(callScope.threadId)!;
+            const task = projection.subagents.find(
+              (candidate: any) => candidate.id === input.taskId,
+            );
+            if (task !== undefined) {
+              task.status = "cancelled";
+              task.completionDelivery = {
+                state: "disposed",
+                observedByRunId: null,
+              };
+            }
+            return { taskId: input.taskId, status: "cancel_requested" };
+          }),
+      } as any;
+      const services = Layer.mergeAll(
+        Layer.succeed(ThreadManagementService, {
+          getThreadProjection: (id: string) => Effect.succeed(projections.get(id)!),
+        } as any),
+        Layer.succeed(OrchestratorMcpService, orchestrator),
+      );
+      const built = yield* Layer.build(
+        layer.pipe(Layer.provide(services), Layer.provide(threadLaunchLayer)),
+      );
+      const service = Context.get(built, BruvTaskService);
+      const launched = yield* service.launch(scope, {
+        clientRequestId: "request-1",
+        prompt: "Implement feature",
+        profile: "normal",
+      });
+      expect(launched).toEqual({
+        version: 1,
+        taskId: "node-child",
+        childThreadId: "thread-child",
+        childRunId: "run-child",
+        childNodeId: "node-child",
+        status: "running",
+        profile: "normal",
+        depth: 1,
+      });
+      expect(delegated[0]).toMatchObject({
+        mode: "async",
+        clientRequestId: "request-1",
+        target: {
+          providerInstanceId: "pi",
+          options: [{ id: "instructionMode", value: "normal" }],
+        },
+      });
+
+      child.runs[0].status = "completed";
+      parent.subagents[0].status = "completed";
+      parent.subagents[0].result = "done";
+      parent.contextTransfers.push({
+        id: "transfer-1",
+        type: "subagent_result",
+        sourceThreadId: "thread-child",
+        targetThreadId: "thread-parent",
+        sourcePoint: { runId: "run-child" },
+      });
+      expect((yield* service.observe(scope, "node-child" as never)).output).toBe("done");
+      expect((yield* service.list(scope, {})).tasks).toHaveLength(1);
+      expect(cancelled).toHaveLength(0);
+      // Model the production idle-ancestor state: its own run is terminal, but
+      // the durable parent task remains nonterminal while descendants run.
+      parent.subagents[0].status = "waiting";
+      parent.subagents[0].result = null;
+      parent.subagents.push({
+        id: "node-sibling",
+        threadId: "thread-parent",
+        childThreadId: "thread-sibling",
+        origin: "app_owned",
+        prompt: "[bruv-native-task:v1] profile=fast\nsibling",
+        status: "running",
+        result: null,
+      });
+
+      child.subagents.push({
+        id: "node-grandchild",
+        threadId: "thread-child",
+        childThreadId: "thread-grandchild",
+        origin: "app_owned",
+        prompt: "nested",
+        status: "running",
+        result: null,
+      });
+      // A terminal own turn is not task completion while delegated work remains.
+      expect((yield* service.observe(scope, "node-child" as never)).status).toBe("running");
+      yield* service.cancel(scope, { taskId: "node-child" as never });
+      expect(cancelled).toEqual([
+        ["thread-parent", "node-child"],
+        ["thread-child", "node-grandchild"],
+      ]);
+      expect(parent.subagents.find((task: any) => task.id === "node-sibling")?.status).toBe(
+        "running",
+      );
+      yield* service.cancel(scope, { taskId: "node-child" as never });
+      expect(cancelled).toHaveLength(2);
+    }),
+);
+
+it.effect("rejects fast/normal parents, depth overflow, and conflicting request replay", () =>
+  Effect.gen(function* () {
+    const parent = thread("thread-parent", null, "orchestrator");
+    const child = thread("thread-child", "thread-parent", "normal");
+    child.runs.push({
+      id: "run-child",
+      status: "running",
+      ordinal: 1,
+      startedAt: now,
+      modelSelection: child.thread.modelSelection,
+    });
+    const projections = new Map([
+      ["thread-parent", parent],
+      ["thread-child", child],
+    ]);
+    const orchestrator = {
+      delegateTask: (_: any, input: any) =>
+        Effect.sync(() => {
+          if (parent.subagents.length === 0)
+            parent.subagents.push({
+              id: "node-child",
+              threadId: "thread-parent",
+              childThreadId: "thread-child",
+              origin: "app_owned",
+              prompt: input.task,
+              delegatedWorkspace: input.delegatedWorkspace,
+            });
+          return {
+            taskId: "node-child",
+            childThreadId: "thread-child",
+            childRunId: "run-child",
+          };
+        }),
+    } as any;
+    const services = Layer.mergeAll(
+      Layer.succeed(ThreadManagementService, {
+        getThreadProjection: (id: string) => Effect.succeed(projections.get(id)!),
+      } as any),
+      Layer.succeed(OrchestratorMcpService, orchestrator),
+    );
+    const built = yield* Layer.build(
+      layer.pipe(Layer.provide(services), Layer.provide(threadLaunchLayer)),
+    );
+    const service = Context.get(built, BruvTaskService);
+    yield* service.launch(scope, {
+      clientRequestId: "same",
+      prompt: "one",
+      profile: "normal",
+    });
+    const conflict = yield* Effect.flip(
+      service.launch(scope, {
+        clientRequestId: "same",
+        prompt: "two",
+        profile: "normal",
+      }),
+    );
+    expect(conflict.code).toBe("invalid_request");
+    const denied = yield* Effect.flip(
+      service.launch(
+        {
+          ...scope,
+          threadId: "thread-child",
+          bruvDelegation: { profile: "normal", depth: 1 },
+        },
+        { clientRequestId: "nested", prompt: "x", profile: "fast" },
+      ),
+    );
+    expect(denied.code).toBe("capability_denied");
+    const nestedOrchestrator = yield* Effect.flip(
+      service.launch(
+        { ...scope, bruvDelegation: { profile: "orchestrator", depth: 1 } },
+        {
+          clientRequestId: "nested-orchestrator",
+          prompt: "x",
+          profile: "orchestrator",
+        },
+      ),
+    );
+    expect(nestedOrchestrator.code).toBe("capability_denied");
+    const maxDepth = yield* Effect.flip(
+      service.launch(
+        { ...scope, bruvDelegation: { profile: "orchestrator", depth: 2 } },
+        { clientRequestId: "deep", prompt: "x", profile: "fast" },
+      ),
+    );
+    expect(maxDepth.code).toBe("capability_denied");
+    const unsupportedTimeout = yield* Effect.flip(
+      service.launch(scope, {
+        clientRequestId: "deadline",
+        prompt: "x",
+        profile: "fast",
+        timeoutMs: 100,
+      }),
+    );
+    expect(unsupportedTimeout.message).toContain("does not yet support");
+    const forged = yield* Effect.flip(
+      service.launch(
+        { ...scope, bruvDelegation: undefined },
+        { clientRequestId: "forged", prompt: "x", profile: "orchestrator" },
+      ),
+    );
+    expect(forged.code).toBe("capability_denied");
+  }),
+);
+
+it.effect(
+  "cancellation fence tears down descendants and rejects a launch paused before dispatch",
+  () =>
+    Effect.gen(function* () {
+      const root = thread("thread-root", null, "orchestrator");
+      const child = thread("thread-child-race", "thread-root", "orchestrator");
+      const existing = thread("thread-existing", "thread-child-race", "normal");
+      root.subagents.push({
+        id: "node-child-race",
+        threadId: "thread-root",
+        childThreadId: "thread-child-race",
+        origin: "app_owned",
+        prompt: "<bruv-delegation-v1> profile=orchestrator\nchild",
+        status: "running",
+        result: null,
+      });
+      child.subagents.push({
+        id: "node-existing",
+        threadId: "thread-child-race",
+        childThreadId: "thread-existing",
+        origin: "app_owned",
+        prompt: "<bruv-delegation-v1> profile=normal\nexisting",
+        status: "running",
+        result: null,
+      });
+      const projections = new Map([
+        ["thread-root", root],
+        ["thread-child-race", child],
+        ["thread-existing", existing],
+      ]);
+      const atCreationBoundary = yield* Deferred.make<void>();
+      const resumeCreation = yield* Deferred.make<void>();
+      const cancelled: string[] = [];
+      let launchedProcesses = 0;
+      const orchestrator = {
+        delegateTask: () =>
+          Effect.gen(function* () {
+            yield* Deferred.succeed(atCreationBoundary, undefined);
+            yield* Deferred.await(resumeCreation);
+            const edge = root.subagents[0]!;
+            if (edge.status === "cancelled" || edge.completionDelivery?.state === "disposed")
+              return yield* Effect.fail({ _tag: "OrchestratorMcpFailure" });
+            launchedProcesses += 1;
+            return {
+              taskId: "node-late",
+              childThreadId: "thread-late",
+              childRunId: "run-late",
+            };
+          }),
+        cancelTask: (callScope: any, input: any) =>
+          Effect.sync(() => {
+            cancelled.push(input.taskId);
+            const projection = projections.get(callScope.threadId)!;
+            const task = projection.subagents.find(
+              (candidate: any) => candidate.id === input.taskId,
+            )!;
+            task.status = "cancelled";
+            task.completionDelivery = { state: "disposed", observedByRunId: null };
+            return { taskId: input.taskId, status: "cancel_requested" };
+          }),
+      } as any;
+      const services = Layer.mergeAll(
+        Layer.succeed(ThreadManagementService, {
+          getThreadProjection: (id: string) => Effect.succeed(projections.get(id)!),
+        } as any),
+        Layer.succeed(OrchestratorMcpService, orchestrator),
+      );
+      const built = yield* Layer.build(
+        layer.pipe(Layer.provide(services), Layer.provide(threadLaunchLayer)),
+      );
+      const service = Context.get(built, BruvTaskService);
+      const childScope = {
+        ...scope,
+        threadId: "thread-child-race",
+        bruvDelegation: { profile: "orchestrator", depth: 1 },
+      } as any;
+      const rootScope = { ...scope, threadId: "thread-root" } as any;
+
+      const launchFiber = yield* service
+        .launch(childScope, {
+          clientRequestId: "late-launch",
+          prompt: "must not start",
+          profile: "normal",
+        })
+        .pipe(Effect.forkChild);
+      yield* Deferred.await(atCreationBoundary);
+      yield* service.cancel(rootScope, { taskId: "node-child-race" as never });
+      yield* Deferred.succeed(resumeCreation, undefined);
+      const launchExit = yield* Fiber.await(launchFiber);
+
+      expect(launchExit._tag).toBe("Failure");
+      expect(cancelled).toEqual(["node-child-race", "node-existing"]);
+      expect(launchedProcesses).toBe(0);
+      expect(child.subagents.some((task: any) => task.id === "node-late")).toBe(false);
+    }),
+);
+
+it.effect("commits local shell wakes with stable durable ownership", () =>
+  Effect.gen(function* () {
+    const parent = thread("thread-parent", null, "orchestrator");
+    parent.runs.push({
+      id: "run-source",
+      threadId: "thread-parent",
+      status: "completed",
+      providerInstanceId: "pi",
+      providerThreadId: "provider-thread",
+    });
+    parent.thread.activeProviderThreadId = "provider-thread";
+    parent.providerThreads.push({
+      id: "provider-thread",
+      appThreadId: "thread-parent",
+      providerInstanceId: "pi",
+      driver: "pi",
+      providerSessionId: "runtime-session-not-credential-id",
+    });
+    parent.nodes = [
+      {
+        id: "node-shell",
+        threadId: "thread-parent",
+        runId: "run-source",
+        kind: "tool_call",
+        status: "completed",
+        nativeItemRef: { driver: "pi", nativeId: "bruv-shell:task-local", strength: "strong" },
+      },
+    ];
+    const dispatched: any[] = [];
+    const services = Layer.mergeAll(
+      Layer.succeed(ThreadManagementService, {
+        getThreadProjection: () => Effect.succeed(parent),
+        dispatch: (command: any) =>
+          Effect.sync(() => {
+            dispatched.push(command);
+            if (!parent.messages.some((message: any) => message.id === command.messageId))
+              parent.messages.push({ id: command.messageId });
+          }),
+      } as any),
+      Layer.succeed(OrchestratorMcpService, {} as any),
+    );
+    const built = yield* Layer.build(
+      layer.pipe(Layer.provide(services), Layer.provide(threadLaunchLayer)),
+    );
+    const service = Context.get(built, BruvTaskService);
+    const input = {
+      version: 1 as const,
+      notificationId: "stable-notification",
+      taskId: "task-local",
+      kind: "completion" as const,
+      text: "local command completed",
+    };
+    expect(yield* service.notifyLocalJob(scope, input)).toEqual({
+      version: 1,
+      notificationId: "stable-notification",
+      state: "committed",
+    });
