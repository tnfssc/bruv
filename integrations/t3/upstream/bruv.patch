@@ -0,0 +1,101 @@
+import { describe, expect, it } from "@effect/vitest";
+
+import {
+  bruvWebPrincipal,
+  isAllowedBruvWebRequest,
+  isBruvWebNoAuthEnabled,
+} from "./BruvWebAuth.ts";
+
+describe("BruvWebAuth", () => {
+  it("only enables no-auth for explicit web-mode loopback listeners", () => {
+    expect(
+      isBruvWebNoAuthEnabled({
+        requested: true,
+        mode: "web",
+        host: "127.0.0.1",
+        tailscaleServeEnabled: false,
+      }),
+    ).toBe(true);
+    expect(
+      isBruvWebNoAuthEnabled({
+        requested: false,
+        mode: "web",
+        host: "127.0.0.1",
+        tailscaleServeEnabled: false,
+      }),
+    ).toBe(false);
+    expect(
+      isBruvWebNoAuthEnabled({
+        requested: true,
+        mode: "desktop",
+        host: "127.0.0.1",
+        tailscaleServeEnabled: false,
+      }),
+    ).toBe(false);
+    expect(
+      isBruvWebNoAuthEnabled({
+        requested: true,
+        mode: "web",
+        host: "0.0.0.0",
+        tailscaleServeEnabled: false,
+      }),
+    ).toBe(false);
+    expect(
+      isBruvWebNoAuthEnabled({
+        requested: true,
+        mode: "web",
+        host: undefined,
+        tailscaleServeEnabled: false,
+      }),
+    ).toBe(false);
+    expect(
+      isBruvWebNoAuthEnabled({
+        requested: true,
+        mode: "web",
+        host: "::1",
+        tailscaleServeEnabled: true,
+      }),
+    ).toBe(false);
+  });
+
+  it("allows exact same-origin loopback browser HTTP and WebSocket requests", () => {
+    const requestUrl = new URL("http://127.0.0.1:3773/ws");
+    expect(
+      isAllowedBruvWebRequest({
+        requestUrl,
+        origin: "http://127.0.0.1:3773",
+        secFetchSite: "same-origin",
+      }),
+    ).toBe(true);
+    expect(
+      isAllowedBruvWebRequest({ requestUrl, origin: undefined, secFetchSite: undefined }),
+    ).toBe(true);
+    expect(bruvWebPrincipal.scopes).toContain("terminal:operate");
+    expect(bruvWebPrincipal.scopes).toContain("orchestration:operate");
+  });
+
+  it.each([
+    ["external origin", "https://evil.example", "cross-site"],
+    ["wrong loopback port", "http://127.0.0.1:9999", "same-origin"],
+    ["opaque origin", "null", "cross-site"],
+    ["different loopback host", "http://localhost:3773", "same-origin"],
+  ])("rejects %s", (_label, origin, secFetchSite) => {
+    expect(
+      isAllowedBruvWebRequest({
+        requestUrl: new URL("http://127.0.0.1:3773/api"),
+        origin,
+        secFetchSite,
+      }),
+    ).toBe(false);
+  });
+
+  it("rejects DNS-rebinding style nonloopback Host URLs", () => {
+    expect(
+      isAllowedBruvWebRequest({
+        requestUrl: new URL("http://evil.example:3773/api"),
+        origin: "http://evil.example:3773",
+        secFetchSite: "same-origin",
+      }),
+    ).toBe(false);
+  });
+});
