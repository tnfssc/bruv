index 0000000000000000000000000000000000000000..5975e00385c0bb827c2a173097472a7989239485
--- /dev/null
+++ b/apps/server/src/orchestration-v2/DelegatedCompletionWake.ts
@@ -0,0 +1,25 @@
+import type { OrchestrationV2ThreadProjection } from "@t3tools/contracts";
+
+import { profileFromMarkedPrompt } from "../mcp/BruvDelegationPolicy.ts";
+
+/** Agent-facing read instruction selected from the durable task's launch kind. */
+export function delegatedCompletionWakeText(
+  projection: Pick<OrchestrationV2ThreadProjection, "subagents">,
+  taskIds: ReadonlyArray<string>,
+): string {
+  const taskList = taskIds.join(", ");
+  const nativeBruvTasks =
+    taskIds.length > 0 &&
+    taskIds.every((id) => {
+      const task = projection.subagents?.find((candidate) => candidate.id === id);
+      return task?.origin === "app_owned" && profileFromMarkedPrompt(task.prompt) !== undefined;
+    });
+  if (nativeBruvTasks) {
+    return taskIds.length === 1
+      ? `Delegated task ${taskList} reached a terminal state. Use execute and await jobs.inspect("${taskList}") to read the result (this uses bruv_task_observe).`
+      : `Delegated tasks ${taskList} reached terminal states. Use execute and await jobs.inspect(id) for each task to read the results (this uses bruv_task_observe).`;
+  }
+  return taskIds.length === 1
+    ? `Delegated task ${taskList} reached a terminal state. Use task_status with taskId ${taskList} to read the result.`
+    : `Delegated tasks ${taskList} reached terminal states. Use task_status with each taskId to read the results.`;
+}
