index 0000000000000000000000000000000000000000..613394eab85375fe4bd2c4cf9a8163d8463652f6
--- /dev/null
+++ b/apps/server/src/mcp/BruvDelegationPolicy.test.ts
@@ -0,0 +1,107 @@
+// @effect-diagnostics nodeBuiltinImport:off
+import { expect, it } from "@effect/vitest";
+import { mkdtemp, writeFile } from "node:fs/promises";
+import { join } from "node:path";
+
+import { deriveBruvDelegationPolicy, resolveBruvProfileSelection } from "./BruvDelegationPolicy.ts";
+
+it("resolves exact trusted fast/normal model and thinking configuration", async () => {
+  const dir = await mkdtemp("/var/tmp/bruv-profiles-");
+  const path = join(dir, "subagents.json");
+  await writeFile(
+    path,
+    JSON.stringify({
+      fast: { model: "vendor/fast-model", thinking: "low" },
+      normal: { model: "vendor/normal-model", thinking: "high" },
+    }),
+  );
+  const parent = {
+    instanceId: "pi",
+    model: "vendor/parent",
+    options: [{ id: "thinking", value: "medium" }],
+  } as any;
+  await expect(resolveBruvProfileSelection("fast", parent, path)).resolves.toEqual({
+    providerInstanceId: "pi",
+    model: "vendor/fast-model",
+    options: [
+      { id: "instructionMode", value: "fast" },
+      { id: "thinking", value: "low" },
+    ],
+  });
+  await expect(resolveBruvProfileSelection("normal", parent, path)).resolves.toEqual({
+    providerInstanceId: "pi",
+    model: "vendor/normal-model",
+    options: [
+      { id: "instructionMode", value: "normal" },
+      { id: "thinking", value: "high" },
+    ],
+  });
+});
+
+it("derives role and depth only from trusted durable lineage", async () => {
+  const root = {
+    thread: {
+      id: "root",
+      lineage: { parentThreadId: null, relationshipToParent: null },
+    },
+    subagents: [
+      {
+        childThreadId: "child",
+        origin: "app_owned",
+        status: "running",
+        prompt: "<bruv-delegation-v1> profile=normal\nwork",
+      },
+    ],
+  } as any;
+  const child = {
+    thread: {
+      id: "child",
+      lineage: { parentThreadId: "root", relationshipToParent: "subagent" },
+    },
+    subagents: [],
+  } as any;
+  const values = new Map([
+    ["root", root],
+    ["child", child],
+  ]);
+  const load = async (id: any) => values.get(id)!;
+  await expect(deriveBruvDelegationPolicy("child" as any, false, load)).resolves.toBeUndefined();
+  await expect(deriveBruvDelegationPolicy("child" as any, true, load)).resolves.toEqual({
+    profile: "normal",
+    depth: 1,
+  });
+  root.subagents[0].prompt = "caller-forged profile=orchestrator";
+  await expect(deriveBruvDelegationPolicy("child" as any, true, load)).resolves.toBeUndefined();
+});
+
+it("treats terminal or disposed ancestor edges as durable cancellation fences", async () => {
+  const root = {
+    thread: { id: "root", lineage: { parentThreadId: null, relationshipToParent: null } },
+    subagents: [
+      {
+        childThreadId: "child",
+        origin: "app_owned",
+        status: "cancelled",
+        prompt: "<bruv-delegation-v1> profile=orchestrator\nwork",
+        completionDelivery: { state: "disposed", observedByRunId: null },
+      },
+    ],
+  } as any;
+  const child = {
+    thread: {
+      id: "child",
+      lineage: { parentThreadId: "root", relationshipToParent: "subagent" },
+    },
+    subagents: [],
+  } as any;
+  const load = async (id: any) => (id === "root" ? root : child);
+
+  await expect(deriveBruvDelegationPolicy("child" as any, true, load)).resolves.toBeUndefined();
+  root.subagents[0].status = "running";
+  await expect(deriveBruvDelegationPolicy("child" as any, true, load)).resolves.toBeUndefined();
+  root.subagents[0].completionDelivery = { state: "pending", observedByRunId: null };
+  await expect(deriveBruvDelegationPolicy("child" as any, true, load)).resolves.toEqual({
+    profile: "orchestrator",
+    depth: 1,
+  });
+});
