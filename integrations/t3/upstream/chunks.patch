diff --git a/apps/web/src/lib/heicDecode.worker.ts b/apps/web/src/lib/heicDecode.worker.ts
new file mode 100644
--- /dev/null
+++ b/apps/web/src/lib/heicDecode.worker.ts
@@ -0,0 +1,43 @@
+import libheifFactory from "libheif-js/libheif-wasm/libheif.js";
+import wasmUrl from "libheif-js/libheif-wasm/libheif.wasm?url";
+
+// The decoder code is small; the binary is fetched only when converting a HEIC image.
+const decoder = fetch(wasmUrl)
+  .then((response) => {
+    if (!response.ok) throw new Error("Unable to load HEIC decoder");
+    return response.arrayBuffer();
+  })
+  .then((wasmBinary) => libheifFactory({ wasmBinary }));
+
+self.onmessage = async (event: MessageEvent<{ id: number; buffer: ArrayBuffer; quality: number }>) => {
+  const { id, buffer, quality } = event.data;
+  try {
+    const libheif = await decoder;
+    const heifDecoder = new libheif.HeifDecoder();
+    const images = heifDecoder.decode(new Uint8Array(buffer));
+    try {
+      const image = images[0];
+      if (!image) throw new Error("No HEIC image found");
+      const width = image.get_width();
+      const height = image.get_height();
+      const canvas = new OffscreenCanvas(width, height);
+      const context = canvas.getContext("2d");
+      if (!context) throw new Error("HEIC canvas unavailable");
+      const pixels = context.createImageData(width, height);
+      await new Promise<void>((resolve, reject) => {
+        image.display(pixels, (result) => {
+          if (!result) return reject(new Error("HEIC decode failed"));
+          context.putImageData(result, 0, 0);
+          resolve();
+        });
+      });
+      const blob = await canvas.convertToBlob({ type: "image/jpeg", quality });
+      self.postMessage({ id, blob });
+    } finally {
+      for (const image of images) image.free();
+      if (heifDecoder.decoder) libheif.heif_context_free(heifDecoder.decoder);
+    }
+  } catch (error) {
+    self.postMessage({ id, error: String(error) });
+  }
+};
diff --git a/apps/web/src/lib/heicToWasm.ts b/apps/web/src/lib/heicToWasm.ts
new file mode 100644
--- /dev/null
+++ b/apps/web/src/lib/heicToWasm.ts
@@ -0,0 +1,32 @@
+let worker: Worker | undefined;
+let nextId = 0;
+const requests = new Map<number, { resolve: (blob: Blob) => void; reject: (error: Error) => void }>();
+
+function getWorker(): Worker {
+  if (worker) return worker;
+  const instance = new Worker(new URL("./heicDecode.worker.ts", import.meta.url), { type: "module" });
+  instance.onmessage = (event: MessageEvent<{ id: number; blob?: Blob; error?: string }>) => {
+    const request = requests.get(event.data.id);
+    if (!request) return;
+    requests.delete(event.data.id);
+    if (event.data.blob) request.resolve(event.data.blob);
+    else request.reject(new Error(event.data.error ?? "HEIC decode failed"));
+  };
+  instance.onerror = (error) => {
+    for (const request of requests.values()) request.reject(new Error(error.message));
+    requests.clear();
+    worker = undefined;
+    instance.terminate();
+  };
+  worker = instance;
+  return instance;
+}
+
+export async function heicTo({ blob, quality }: { blob: Blob; type: "image/jpeg"; quality: number }): Promise<Blob> {
+  const buffer = await blob.arrayBuffer();
+  const id = ++nextId;
+  return new Promise((resolve, reject) => {
+    requests.set(id, { resolve, reject });
+    getWorker().postMessage({ id, buffer, quality }, [buffer]);
+  });
+}
diff --git a/apps/web/src/lib/libheif-js.d.ts b/apps/web/src/lib/libheif-js.d.ts
new file mode 100644
--- /dev/null
+++ b/apps/web/src/lib/libheif-js.d.ts
@@ -0,0 +1,18 @@
+declare module "libheif-js/libheif-wasm/libheif.js" {
+  interface HeifImage {
+    free(): void;
+    get_width(): number;
+    get_height(): number;
+    display(image: ImageData, callback: (result: ImageData | null) => void): void;
+  }
+  interface Decoder {
+    decoder: number | null;
+    decode(data: Uint8Array): HeifImage[];
+  }
+  interface Heif {
+    HeifDecoder: new () => Decoder;
+    heif_context_free(context: number): void;
+  }
+  const factory: (options: { wasmBinary: ArrayBuffer }) => Promise<Heif>;
+  export default factory;
+}
