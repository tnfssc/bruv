diff --git a/apps/server/src/numericContracts.test.ts b/apps/server/src/numericContracts.test.ts
new file mode 100644
index 00000000..6ec7e664
--- /dev/null
+++ b/apps/server/src/numericContracts.test.ts
@@ -0,0 +1,60 @@
+import { describe, expect, it } from "@effect/vitest";
+import * as Schema from "effect/Schema";
+
+import { EventNdjsonLogConfigurationError } from "./provider/Layers/EventNdjsonLogger.ts";
+
+// These are the numeric shapes used at the different boundaries: JSON payloads,
+// optional provider fields, SQLite row values and tagged diagnostic errors.
+const jsonPayload = Schema.fromJsonString(Schema.Struct({ expiresAt: Schema.Finite }));
+const providerPayload = Schema.Struct({
+  billingCycleEnd: Schema.optional(Schema.Union([Schema.String, Schema.Finite])),
+  percent: Schema.optional(Schema.NullOr(Schema.Finite)),
+});
+const sqliteRow = Schema.Struct({ count: Schema.Finite, isStreaming: Schema.Finite });
+
+const nonfinite = [NaN, Infinity, -Infinity];
+
+describe("finite numeric boundaries", () => {
+  it("accepts finite wire values and rejects nonfinite encoding before JSON turns them into null", () => {
+    expect(Schema.encodeSync(jsonPayload)({ expiresAt: 0 })).toBe('{"expiresAt":0}');
+    expect(Schema.decodeSync(jsonPayload)('{"expiresAt":1700000000000}')).toEqual({
+      expiresAt: 1700000000000,
+    });
+    for (const value of nonfinite) {
+      expect(() => Schema.encodeSync(jsonPayload)({ expiresAt: value })).toThrow();
+      expect(() => Schema.decodeUnknownSync(jsonPayload)({ expiresAt: value })).toThrow();
+    }
+  });
+
+  it("retains optional/null/string provider values but rejects nonfinite percentages and timestamps", () => {
+    const decode = Schema.decodeUnknownSync(providerPayload);
+    expect(decode({})).toEqual({});
+    expect(decode({ billingCycleEnd: "2026-09-27", percent: null })).toEqual({
+      billingCycleEnd: "2026-09-27", percent: null,
+    });
+    expect(decode({ billingCycleEnd: 123, percent: 100 })).toEqual({ billingCycleEnd: 123, percent: 100 });
+    for (const value of nonfinite) {
+      expect(() => decode({ percent: value })).toThrow();
+      expect(() => decode({ billingCycleEnd: value })).toThrow();
+    }
+  });
+
+  it("accepts SQL finite counts/boolean flags including zero, not nonfinite row data", () => {
+    const decode = Schema.decodeUnknownSync(sqliteRow);
+    expect(decode({ count: 0, isStreaming: 1 })).toEqual({ count: 0, isStreaming: 1 });
+    for (const value of nonfinite) {
+      expect(() => decode({ count: value, isStreaming: 0 })).toThrow();
+      expect(() => decode({ count: 0, isStreaming: value })).toThrow();
+    }
+  });
+
+  it("rejects nonfinite diagnostic values at the real tagged-error schema", () => {
+    const decode = Schema.decodeUnknownSync(EventNdjsonLogConfigurationError);
+    const error = { _tag: "EventNdjsonLogConfigurationError", filePath: "events.ndjson", option: "maxBufferedBytes", value: 5, minimum: 1 };
+    expect(decode(error).value).toBe(5);
+    for (const value of nonfinite) {
+      expect(() => decode({ ...error, value })).toThrow();
+      expect(() => decode({ ...error, minimum: value })).toThrow();
+    }
+  });
+});
