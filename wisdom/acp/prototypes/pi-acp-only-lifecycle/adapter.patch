index 0000000..6e08a22
--- /dev/null
+++ b/src/acp/bruv-work.ts
@@ -0,0 +1,28 @@
+// Experimental local-Bruv proof only; no native T3 routing or MCP parity.
+export class BruvWork {
+  private jobs = new Map<string, 'running' | 'delivery'>()
+  private unclassified = new Set<string>()
+  version = 0
+  observe(ev: any): void {
+    if (['agent_start', 'agent_end', 'agent_settled', 'bruv_task_event', 'tool_execution_end', 'message_end'].includes(ev.type)) this.version++
+    if (ev.type === 'bruv_task_event' && typeof ev.task?.id === 'string') {
+      if (ev.event === 'started') { this.jobs.set(ev.task.id, 'running'); this.unclassified.add(ev.task.id) }
+      if (ev.event === 'completed') this.jobs.set(ev.task.id, 'delivery')
+    }
+    // execute result details explicitly identify jobs that returned in background.
+    // Synchronous shell commands also emit lifecycle telemetry, but have no late delivery.
+    if (ev.type === 'tool_execution_end' && ev.toolName === 'execute') {
+      const background = new Set(ev.result?.details?.backgroundJobs ?? [])
+      for (const id of this.unclassified) if (!background.has(id)) this.jobs.delete(id)
+      this.unclassified.clear()
+    }
+    // CompletionBatcher emits this typed custom message after its delayed flush.
+    // Lifecycle completion alone is NOT evidence that the continuation ran.
+    if (ev.type === 'message_end' && ev.message?.role === 'custom' && ev.message.customType === 'task-complete') {
+      for (const task of ev.message.details?.tasks ?? []) {
+        if (typeof task.id === 'string' && this.jobs.get(task.id) === 'delivery') this.jobs.delete(task.id)
+      }
+    }
+  }
+  get pending(): number { return this.jobs.size }
+}
