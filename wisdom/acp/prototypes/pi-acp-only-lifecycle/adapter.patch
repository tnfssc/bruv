diff --git a/test/unit/bruv-session.test.ts b/test/unit/bruv-session.test.ts
new file mode 100644
index 0000000..e640333
--- /dev/null
+++ b/test/unit/bruv-session.test.ts
@@ -0,0 +1,58 @@
+import test from 'node:test'
+import assert from 'node:assert/strict'
+import { PiAcpSession } from '../../src/acp/session.js'
+import { FakeAgentSideConnection, FakePiRpcProcess, asAgentConn } from '../helpers/fakes.js'
+const tick = () => new Promise<void>(resolve => setImmediate(resolve))
+function create(proc = new FakePiRpcProcess()) {
+ return {proc, session: new PiAcpSession({sessionId:'proof',cwd:process.cwd(),mcpServers:[],proc:proc as any,conn:asAgentConn(new FakeAgentSideConnection()),fileCommands:[]})}
+}
+test('prompt preflight failure rejects current and all queued callers', async () => {
+ const {proc,session} = create()
+ proc.prompt = async () => { throw new Error('proof preflight failure') }
+ const first = session.prompt('first'), second = session.prompt('second')
+ await Promise.all([assert.rejects(first,/proof preflight failure/),assert.rejects(second,/proof preflight failure/)])
+})
+test('prototype owns root and genuine concurrent input through typed completion delivery', async () => {
+ process.env.PI_ACP_BRUV_PROTOTYPE='1'
+ const {proc,session}=create()
+ delete process.env.PI_ACP_BRUV_PROTOTYPE
+ let settled=false
+ const first=session.prompt('first').then(reason=>{settled=true;return reason})
+ await tick()
+ proc.emit({type:'agent_start'})
+ proc.emit({type:'bruv_task_event',event:'started',task:{id:'job'}} as any)
+ proc.emit({type:'tool_execution_end',toolName:'execute',result:{details:{backgroundJobs:['job']}}} as any)
+ proc.emit({type:'agent_end'})
+ proc.emit({type:'agent_settled'})
+ await tick()
+ assert.equal(settled,false)
+ const second=session.prompt('real followup')
+ await tick()
+ assert.equal(proc.prompts.length,2)
+ proc.emit({type:'bruv_task_event',event:'completed',task:{id:'job'}} as any)
+ proc.emit({type:'agent_settled'})
+ await tick()
+ assert.equal(settled,false)
+ proc.emit({type:'message_end',message:{role:'custom',customType:'task-complete',details:{tasks:[{id:'job'}]}}} as any)
+ proc.emit({type:'agent_settled'})
+ proc.emit({type:'extension_ui_request'} as any)
+ assert.equal(await first,'end_turn')
+ assert.equal(await second,'end_turn')
+})
+test('real prompt arriving during cancellation is not joined to the cancelled owner', async () => {
+ process.env.PI_ACP_BRUV_PROTOTYPE='1'
+ const {proc,session}=create()
+ delete process.env.PI_ACP_BRUV_PROTOTYPE
+ const first=session.prompt('first')
+ await tick()
+ const cancelling=session.cancel()
+ const followup=session.prompt('after cancel')
+ await cancelling
+ assert.equal(await first,'cancelled')
+ await tick()
+ assert.equal(proc.prompts.length,2)
+ proc.emit({type:'agent_start'})
+ proc.emit({type:'agent_end'})
+ proc.emit({type:'agent_settled'})
+ assert.equal(await followup,'end_turn')
+})
diff --git a/test/unit/bruv-work.test.ts b/test/unit/bruv-work.test.ts
new file mode 100644
index 0000000..1353925
--- /dev/null
+++ b/test/unit/bruv-work.test.ts
@@ -0,0 +1,27 @@
+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+import { BruvWork } from '../../src/acp/bruv-work.js'
+test('completed lifecycle holds ownership until typed delivery; free text does not release', () => {
+ const work = new BruvWork()
+ work.observe({type:'bruv_task_event',event:'started',task:{id:'job-1'}})
+ assert.equal(work.pending,1)
+ work.observe({type:'bruv_task_event',event:'completed',task:{id:'job-1'}})
+ work.observe({type:'agent_settled'})
+ work.observe({type:'message_end',message:{role:'user',content:'1 asynchronous task completed job-1'}})
+ assert.equal(work.pending,1)
+ work.observe({type:'message_end',message:{role:'custom',customType:'task-complete',details:{tasks:[{id:'job-1'}]}}})
+ assert.equal(work.pending,0)
+})
+test('foreground telemetry is not late-work debt; UI telemetry does not invalidate quiescence', () => {
+ const work = new BruvWork()
+ work.observe({type:'bruv_task_event',event:'started',task:{id:'sync'}})
+ work.observe({type:'bruv_task_event',event:'completed',task:{id:'sync'}})
+ work.observe({type:'tool_execution_end',toolName:'execute',result:{details:{backgroundJobs:[]}}})
+ assert.equal(work.pending,0)
+ const version=work.version
+ work.observe({type:'extension_ui_request'})
+ assert.equal(work.version,version)
+ work.observe({type:'bruv_task_event',event:'started',task:{id:'async'}})
+ work.observe({type:'tool_execution_end',toolName:'execute',result:{details:{backgroundJobs:['async']}}})
+ assert.equal(work.pending,1)
+})
