+import { Lexer, Tokenizer } from "marked";
+// Pi's GFM block grammar, evaluated on at most two lines at each boundary.
+// The original whole-block regexes repeat nested alternatives over every character
+// (setext) and a complete table body at every newline (paragraph).
+const rules = Lexer.rules.block.gfm;
+const paragraphBody = "^([^\\n]+(?:\\n(?!";
+const paragraphEnd = rules.paragraph.source.lastIndexOf(")[^\\n]+)*");
+const paragraphContinue = new RegExp("^(?!" + rules.paragraph.source.slice(paragraphBody.length, paragraphEnd) + ")");
+const possibleSetext = /\n {0,3}[=-]/;
+function lineEnd(source, start) {
+    const end = source.indexOf("\n", start);
+    return end < 0 ? source.length : end;
+}
+function lookahead(source, start, end) {
+    return source.slice(start, end < source.length ? Math.min(source.length, lineEnd(source, end + 1) + 1) : end);
+}
+function scanParagraph(source) {
+    let end = lineEnd(source, 0);
+    if (end === 0) return;
+    while (end < source.length) {
+        const start = end + 1;
+        const nextEnd = lineEnd(source, start);
+        if (nextEnd === start) break;
+        // A possible structural interruption keeps Marked's original matcher,
+        // including its full table lookahead and engine-limit behavior.
+        if (!paragraphContinue.test(lookahead(source, start, nextEnd))) return;
+        end = nextEnd;
+    }
+    const raw = source.slice(0, end);
+    return { raw, text: raw };
+}
+
+/** Line-bounded equivalents of Marked's non-pedantic GFM block rules. */
+export class GfmBlockTokenizer extends Tokenizer {
+    constructor() {
+        super();
+        // Marked.use enumerates own hooks and invokes them with its base tokenizer.
+        const hooks = { lheading: this.lheading, paragraph: this.paragraph };
+        Object.assign(this, hooks);
+    }
+    lheading(source) {
+        if (this.options.pedantic || !this.options.gfm) return super.lheading(source);
+        // A setext heading must contain a newline followed by an underline.
+        // Do not run the character-repeating regex when no such line exists.
+        if (possibleSetext.test(source)) return super.lheading(source);
+    }
+    paragraph(source) {
+        if (this.options.pedantic || !this.options.gfm) return super.paragraph(source);
+        const token = scanParagraph(source);
+        if (token) return { type: "paragraph", ...token, tokens: this.lexer.inline(token.text) };
+        return super.paragraph(source);
+    }
+}
